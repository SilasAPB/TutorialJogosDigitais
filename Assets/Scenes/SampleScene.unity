  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27be81e0366253c4895cad81c977e3af, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  portuguese: "As suas amarras parecem maiores do que nunca. O seu estado, f\xEDsico e mental, n\xE3o permitiu nem ao menos administrar o pr\xF3prio lar, e voc\xEA voltou ao Brasileir\xE3o S\xE9rie B, colocando suas \xFAnicas esperan\xE7as no Coring\xE3o (o Corinthians de Seedorf)."
  english: "Your chains seem bigger than ever. Your state, both physical and mental, did not even allow you to run your own home, and you went back to the Brazilian S\xE9rie B, placing your only hopes on Coring\xE3o (Seedorf's Corinthians)."
